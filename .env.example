# SRP AI OS — Environment Variables
# Copy to .env and fill in values

# ─── Database ───
DATABASE_URL=postgresql://srpaios:srpaios_dev@localhost:5432/srpaios
DIRECT_URL=postgresql://srpaios:srpaios_dev@localhost:5432/srpaios

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Auth ───
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ─── AI Providers ───
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ─── Google OAuth (optional) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── App ───
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=SRP AI OS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── File Storage ───
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# ─── Email (placeholder) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@srpaios.com

# ─── Webhook / n8n ───
WEBHOOK_SECRET=change-me-webhook-secret
N8N_BASE_URL=
N8N_WEBHOOK_URL=

# ─── WhatsApp / Twilio (optional) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
